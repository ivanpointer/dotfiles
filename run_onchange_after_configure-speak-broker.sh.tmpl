#!/bin/sh
# Speak broker source SHA-256: {{ includeTemplate "speak.py" . | sha256sum }}
set -eu

label="com.ivanpointer.speak-broker"
domain="gui/$(id -u)"
plist="${HOME}/Library/LaunchAgents/${label}.plist"

[ -f "$plist" ] || {
  echo "Speak broker plist is not deployed: $plist" >&2
  exit 1
}

launchctl bootout "${domain}/${label}" 2>/dev/null || true
launchctl bootstrap "$domain" "$plist"
launchctl kickstart -k "${domain}/${label}"
