#!/bin/sh
# Pi writes runtime fields such as lastChangelogVersion. Declare only selected
# settings here.
set -eu

input="$(cat)"
[ -n "$input" ] || input='{}'

declared="$(cat <<'CHEZMOI_DECLARED'
{{ template "pi-settings.json.tmpl" . }}
CHEZMOI_DECLARED
)"

printf '%s' "$input" | jq --argjson declared "$declared" '
  . + $declared
'
