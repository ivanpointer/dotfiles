{
  "hooks": {
    "Notification": [
      {
        "hooks": [{
          "command": "'{{ .chezmoi.homeDir }}/Library/Application Support/Bartender/NotchBar/AgentStatus/hooks/claude-event-hook.sh' Waiting # notchbar-agents-claude-hook",
          "type": "command"
        }]
      },
      {
        "matcher": "permission_prompt|elicitation_dialog",
        "hooks": [{ "command": "workmux set-window-status waiting", "type": "command" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [{
          "command": "\"{{ .chezmoi.homeDir }}/.local/bin/graft\" agent-hook post-edit # chezmoi-graft-hook",
          "timeout": 10000,
          "type": "command"
        }]
      },
      {
        "matcher": "Bash|mcp__graft__|Read|Grep|Glob",
        "hooks": [{
          "command": "\"{{ .chezmoi.homeDir }}/.local/bin/graft\" agent-hook tool-savings # chezmoi-graft-hook",
          "timeout": 8000,
          "type": "command"
        }]
      },
      {
        "hooks": [{
          "command": "'{{ .chezmoi.homeDir }}/Library/Application Support/Bartender/NotchBar/AgentStatus/hooks/claude-event-hook.sh' Auto # notchbar-agents-claude-hook",
          "type": "command"
        }]
      },
      {
        "hooks": [{ "command": "workmux set-window-status working", "type": "command" }]
      }
    ],
    "PostToolUseFailure": [{
      "hooks": [{
        "command": "'{{ .chezmoi.homeDir }}/Library/Application Support/Bartender/NotchBar/AgentStatus/hooks/claude-event-hook.sh' ToolFail # notchbar-agents-claude-hook",
        "type": "command"
      }]
    }],
    "PreToolUse": [{
      "hooks": [{
        "command": "'{{ .chezmoi.homeDir }}/Library/Application Support/Bartender/NotchBar/AgentStatus/hooks/claude-event-hook.sh' Working # notchbar-agents-claude-hook",
        "type": "command"
      }]
    }],
    "SessionEnd": [{
      "hooks": [{
        "command": "'{{ .chezmoi.homeDir }}/Library/Application Support/Bartender/NotchBar/AgentStatus/hooks/claude-event-hook.sh' Ended # notchbar-agents-claude-hook",
        "type": "command"
      }]
    }],
    "SessionStart": [
      {
        "hooks": [{
          "command": "\"{{ .chezmoi.homeDir }}/.local/bin/graft\" agent-hook session-start # chezmoi-graft-hook",
          "timeout": 8000,
          "type": "command"
        }]
      },
      {
        "hooks": [{
          "command": "'{{ .chezmoi.homeDir }}/Library/Application Support/Bartender/NotchBar/AgentStatus/hooks/claude-event-hook.sh' Idle # notchbar-agents-claude-hook",
          "type": "command"
        }]
      },
      {
        "matcher": "startup|resume|clear|fork",
        "hooks": [{ "command": "workmux register-agent", "type": "command" }]
      }
    ],
    "Stop": [
      {
        "hooks": [{
          "command": "\"{{ .chezmoi.homeDir }}/.local/bin/graft\" agent-hook stop # chezmoi-graft-hook",
          "timeout": 8000,
          "type": "command"
        }]
      },
      {
        "hooks": [{
          "command": "'{{ .chezmoi.homeDir }}/Library/Application Support/Bartender/NotchBar/AgentStatus/hooks/claude-event-hook.sh' Idle # notchbar-agents-claude-hook",
          "type": "command"
        }]
      },
      {
        "hooks": [{
          "command": "SAY_ALERT_SESSION_PREFIX=claude \"{{ .chezmoi.homeDir }}/.local/bin/agent-completion-alert\" # completion-alert-shared-hook",
          "type": "command"
        }]
      },
      {
        "hooks": [{ "command": "workmux set-window-status done", "type": "command" }]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [{
          "command": "\"{{ .chezmoi.homeDir }}/.local/bin/graft\" agent-hook prompt # chezmoi-graft-hook",
          "timeout": 15000,
          "type": "command"
        }]
      },
      {
        "hooks": [{
          "command": "'{{ .chezmoi.homeDir }}/Library/Application Support/Bartender/NotchBar/AgentStatus/hooks/claude-event-hook.sh' Working # notchbar-agents-claude-hook",
          "type": "command"
        }]
      },
      {
        "hooks": [{ "command": "workmux set-window-status working", "type": "command" }]
      }
    ]
  }
}
