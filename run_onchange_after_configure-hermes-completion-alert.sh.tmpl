#!/bin/sh
# Hermes alert shim SHA-256: {{ include "private_dot_hermes/private_hooks/executable_hermes-say-alert.sh" | sha256sum }}
# Graft wrapper SHA-256: {{ include "private_dot_local/bin/executable_graft" | sha256sum }}
# Shell hooks and shared MCP servers are runtime configuration, so register the
# deployed entries after chezmoi has created them. Hermes config set cannot
# express these nested mappings;
# ruamel's round-trip API preserves comments and the pinned indent avoids
# reformatting unrelated sequences.
set -eu

hermes_bin="$(command -v hermes)"
python_bin="$(head -1 "$hermes_bin" | sed 's/^#!//')"
hook_path="${HOME}/.hermes/hooks/hermes-say-alert.sh"
config_path="${HOME}/.hermes/config.yaml"
allowlist_path="${HOME}/.hermes/shell-hooks-allowlist.json"
open_brain_key='{{ onepasswordRead "op://Open-Brain/One-Brain MCP Access Key/password" | trim }}'

[ -x "$hook_path" ] || {
  echo "Hermes alert hook is not deployed: $hook_path" >&2
  exit 1
}

"$python_bin" - "$config_path" "$allowlist_path" "$hook_path" "$open_brain_key" <<'PY'
import datetime as dt
import io
import json
import os
import shutil
import sys
import tempfile
from pathlib import Path

from ruamel.yaml import YAML
from ruamel.yaml.comments import CommentedMap, CommentedSeq

config_path = Path(sys.argv[1])
allowlist_path = Path(sys.argv[2])
hook_path = Path(sys.argv[3])
open_brain_key = sys.argv[4]
config_path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)

yaml = YAML(typ="rt")
yaml.indent(mapping=2, sequence=4, offset=2)

original = config_path.read_bytes() if config_path.exists() else b""
backup_path = None
if config_path.exists():
    backup = tempfile.NamedTemporaryFile(
        prefix="config.yaml.before-hermes-alert.", dir=config_path.parent, delete=False
    )
    backup.close()
    backup_path = Path(backup.name)
    shutil.copy2(config_path, backup_path)

if original:
    loaded = yaml.load(original.decode("utf-8"))
    verify = io.StringIO()
    yaml.dump(loaded, verify)
    if verify.getvalue().encode("utf-8") != original:
        raise SystemExit("refusing to rewrite config.yaml: ruamel round-trip changed unrelated bytes")
else:
    loaded = CommentedMap()
if loaded is None:
    loaded = CommentedMap()
if not isinstance(loaded, CommentedMap):
    raise SystemExit("refusing to rewrite config.yaml: root is not a mapping")

hooks = loaded.get("hooks")
if hooks is None:
    hooks = CommentedMap()
    loaded["hooks"] = hooks
if not isinstance(hooks, CommentedMap):
    raise SystemExit("refusing to rewrite config.yaml: hooks is not a mapping")

entries = hooks.get("on_session_end")
if entries is None:
    entries = CommentedSeq()
    hooks["on_session_end"] = entries
if not isinstance(entries, (list, CommentedSeq)):
    raise SystemExit("refusing to rewrite config.yaml: hooks.on_session_end is not a list")

existing = next(
    (entry for entry in entries if isinstance(entry, dict) and entry.get("command") == str(hook_path)),
    None,
)
config_changed = False
if existing is None:
    entry = CommentedMap()
    entry["command"] = str(hook_path)
    entry["timeout"] = 15
    entries.append(entry)
    config_changed = True
elif existing.get("timeout") != 15:
    existing["timeout"] = 15
    config_changed = True

mcp_servers = loaded.get("mcp_servers")
if mcp_servers is None:
    mcp_servers = CommentedMap()
    loaded["mcp_servers"] = mcp_servers
if not isinstance(mcp_servers, CommentedMap):
    raise SystemExit("refusing to rewrite config.yaml: mcp_servers is not a mapping")

graft = mcp_servers.get("graft")
if graft is None:
    graft = CommentedMap()
    mcp_servers["graft"] = graft
if not isinstance(graft, CommentedMap):
    raise SystemExit("refusing to rewrite config.yaml: mcp_servers.graft is not a mapping")

graft_command = str(Path.home() / ".local" / "bin" / "graft")
if graft.get("command") != graft_command:
    graft["command"] = graft_command
    config_changed = True
if list(graft.get("args") or []) != ["mcp"]:
    graft["args"] = CommentedSeq(["mcp"])
    config_changed = True

onepassword = mcp_servers.get("1password")
if onepassword is None:
    onepassword = CommentedMap()
    mcp_servers["1password"] = onepassword
if not isinstance(onepassword, CommentedMap):
    raise SystemExit("refusing to rewrite config.yaml: mcp_servers.1password is not a mapping")
onepassword_command = "/Applications/1Password.app/Contents/MacOS/1password-mcp"
if onepassword.get("command") != onepassword_command:
    onepassword["command"] = onepassword_command
    config_changed = True

open_brain = mcp_servers.get("open-brain")
if open_brain is None:
    open_brain = CommentedMap()
    mcp_servers["open-brain"] = open_brain
if not isinstance(open_brain, CommentedMap):
    raise SystemExit("refusing to rewrite config.yaml: mcp_servers.open-brain is not a mapping")
open_brain_url = "https://grjyscwkapsgnvrabrmf.supabase.co/functions/v1/open-brain-mcp"
if open_brain.get("url") != open_brain_url:
    open_brain["url"] = open_brain_url
    config_changed = True
headers = open_brain.get("headers")
if headers is None:
    headers = CommentedMap()
    open_brain["headers"] = headers
if not isinstance(headers, CommentedMap):
    raise SystemExit("refusing to rewrite config.yaml: mcp_servers.open-brain.headers is not a mapping")
if headers.get("x-brain-key") != open_brain_key:
    headers["x-brain-key"] = open_brain_key
    config_changed = True

rendered = io.StringIO()
yaml.dump(loaded, rendered)
new_config = rendered.getvalue().encode("utf-8")
if new_config != original:
    config_path.write_bytes(new_config)
if backup_path:
    backup_path.unlink(missing_ok=True)

allowlist = {"approvals": []}
if allowlist_path.exists():
    try:
        candidate = json.loads(allowlist_path.read_text())
        if isinstance(candidate, dict):
            allowlist = candidate
    except Exception:
        pass
approvals = allowlist.get("approvals")
if not isinstance(approvals, list):
    approvals = []
    allowlist["approvals"] = approvals

approved = any(
    isinstance(entry, dict)
    and entry.get("event") == "on_session_end"
    and entry.get("command") == str(hook_path)
    for entry in approvals
)
if not approved:
    mtime = dt.datetime.fromtimestamp(hook_path.stat().st_mtime, dt.timezone.utc)
    now = dt.datetime.now(dt.timezone.utc)
    approvals.append({
        "event": "on_session_end",
        "command": str(hook_path),
        "approved_at": now.isoformat().replace("+00:00", "Z"),
        "script_mtime_at_approval": mtime.isoformat().replace("+00:00", "Z"),
    })
    allowlist_path.write_text(json.dumps(allowlist, indent=2) + "\n")

print("Hermes harness wiring " + ("registered" if config_changed or not approved else "already-registered"))
PY
