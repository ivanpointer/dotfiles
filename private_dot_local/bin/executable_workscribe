#!/bin/sh
export PYTHONPATH="/Users/ivanpointer/Source/codex-workscribe/src${PYTHONPATH:+:$PYTHONPATH}"

for candidate in \
  python3 \
  "$HOME"/.nix-profile/bin/python3* \
  /run/current-system/sw/bin/python3* \
  /usr/local/bin/python3* \
  /opt/homebrew/bin/python3* \
  /nix/store/*/bin/python3*
do
  if command -v "$candidate" >/dev/null 2>&1; then
    python_path="$candidate"
  elif [ -x "$candidate" ]; then
    python_path="$candidate"
  else
    continue
  fi
  if "$python_path" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 12) else 1)' >/dev/null 2>&1; then
    exec "$python_path" -m workscribe "$@"
  fi
done

echo "workscribe requires Python 3.12+ on PATH, in a profile, Homebrew, or /nix/store" >&2
exit 1
