#!/bin/sh
# Stable machine entrypoint for every shell and agent harness. GUI-launched
# harnesses do not inherit .zshenv, so load the same private Graft/Jev settings
# here before handing off to the reproducible package supplied by nix-darwin.
set -eu

env_file="${XDG_CONFIG_HOME:-${HOME}/.config}/graft/environment"
[ ! -r "$env_file" ] || . "$env_file"

if [ -n "${GRAFT_REAL_BIN:-}" ]; then
  real_graft="$GRAFT_REAL_BIN"
else
  # nix-darwin has no /run/current-system link; NixOS does. Keep both
  # declarative profile locations so this generated entrypoint is portable.
  for candidate in \
    /nix/var/nix/profiles/system/sw/bin/graft \
    /run/current-system/sw/bin/graft
  do
    if [ -x "$candidate" ]; then
      real_graft="$candidate"
      break
    fi
  done
  : "${real_graft:=/nix/var/nix/profiles/system/sw/bin/graft}"
fi
if [ ! -x "$real_graft" ]; then
  echo "graft wrapper: installed binary not found at $real_graft" >&2
  exit 127
fi

exec "$real_graft" "$@"
