#!/bin/sh
# Speak agent completion alerts through OpenRouter's Deepgram Flux TTS, with a
# local speech fallback so an alert is never silently lost.

original_text=$*

fallback() {
  if command -v say >/dev/null 2>&1; then
    say "$original_text"
  elif command -v spd-say >/dev/null 2>&1; then
    spd-say "$original_text"
  elif command -v espeak >/dev/null 2>&1; then
    espeak "$original_text"
  fi
}

if [ -z "$original_text" ] || [ -z "${OPENROUTER_API_KEY:-}" ] || ! command -v curl >/dev/null 2>&1; then
  fallback
  exit 0
fi

# Flux can truncate the final word when the input lacks terminal punctuation.
tts_text=$original_text
case $tts_text in
  *[.!?]) ;;
  *) tts_text="${tts_text}." ;;
esac

json_body=$(
  SPEAK_TEXT=$tts_text perl -MJSON::PP -e '
    print JSON::PP->new->utf8->encode({
      model => "deepgram/flux-tts:free",
      input => $ENV{SPEAK_TEXT},
      voice => "flux-alexis-en",
      response_format => "mp3",
    });
  ' 2>/dev/null
)

if [ -z "$json_body" ]; then
  fallback
  exit 0
fi

audio_file=$(mktemp "${TMPDIR:-/tmp}/speak.XXXXXX.mp3") || {
  fallback
  exit 0
}
trap 'rm -f "$audio_file"' EXIT HUP INT TERM

http_status=$(curl --silent --show-error --location --connect-timeout 10 --max-time 60 \
  --output "$audio_file" --write-out '%{http_code}' \
  --header "Authorization: Bearer $OPENROUTER_API_KEY" \
  --header 'Content-Type: application/json' \
  --data "$json_body" \
  https://openrouter.ai/api/v1/audio/speech 2>/dev/null)

if [ "$http_status" = 200 ] && [ -s "$audio_file" ] && [ "$(wc -c < "$audio_file")" -gt 1024 ]; then
  if command -v afplay >/dev/null 2>&1; then
    afplay "$audio_file" && exit 0
  elif command -v mpg123 >/dev/null 2>&1; then
    mpg123 -q "$audio_file" && exit 0
  elif command -v ffplay >/dev/null 2>&1; then
    ffplay -nodisp -autoexit -loglevel error "$audio_file" && exit 0
  fi
fi

fallback
