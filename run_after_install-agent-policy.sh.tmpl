#!/bin/sh
set -eu

root="${AGENT_POLICY_HOME:-$HOME/.local/share/agent-policy}"
remote="${AGENT_POLICY_REMOTE:-git@github.com:ivanpointer/agent-policy.git}"
ref="${AGENT_POLICY_REF:-main}"

if [ ! -e "$root" ]; then
  mkdir -p "$(dirname "$root")"
  git clone --branch "$ref" --single-branch "$remote" "$root"
else
  if [ ! -d "$root/.git" ]; then
    printf '%s\n' "agent-policy: refusing non-repository path $root" >&2
    exit 1
  fi
  if [ "$(git -C "$root" remote get-url origin)" != "$remote" ]; then
    printf '%s\n' "agent-policy: refusing unexpected origin for $root; set AGENT_POLICY_REMOTE to its expected URL" >&2
    exit 1
  fi
  if [ -n "$(git -C "$root" status --porcelain)" ]; then
    printf '%s\n' "agent-policy: refusing dirty checkout $root" >&2
    exit 1
  fi
  git -C "$root" fetch origin "$ref"
  git -C "$root" merge --ff-only "origin/$ref"
fi

"$root/agent-policy" validate
"$root/agent-policy" host-install --runtime --method link
OPENROUTER_FISH_AUDIT_ENABLED="${OPENROUTER_FISH_AUDIT_ENABLED:-1}" \
  "$root/runtime/openrouter-fish-tts/install-native.sh"
printf '%s\n' "agent-policy: updated $ref and reconciled installed harnesses"
