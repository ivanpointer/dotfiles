#!/bin/sh
# Claude owns runtime settings in this file. Chezmoi replaces only its marked
# status/workmux/completion/Graft hook commands and preserves every foreign key.
set -eu

input="$(cat)"
[ -n "$input" ] || input='{}'

declared="$(cat <<'CHEZMOI_DECLARED'
{{ template "claude-hooks.json.tmpl" . }}
CHEZMOI_DECLARED
)"

merged="$(printf '%s' "$input" | jq \
  --argjson declared "$declared" \
  --argjson markers '["# notchbar-agents-claude-hook", "# completion-alert-shared-hook", "# chezmoi-graft-hook"]' \
  --argjson legacyPrefixes '["workmux set-window-status waiting", "workmux set-window-status working", "workmux set-window-status done", "workmux register-agent"]' \
  --arg policyRoot "/{{ .chezmoi.homeDir }}/.local/share/agent-policy" \
  --argjson agentPolicyAllow '[
    "Read(/{{ .chezmoi.homeDir }}/.local/share/agent-policy/packaging/compiled/communication/high-context/generic-append-only.md)",
    "Read(/{{ .chezmoi.homeDir }}/.local/share/agent-policy/policies/communication/POLICY.md)",
    "Read(/{{ .chezmoi.homeDir }}/.local/share/agent-policy/policies/documents/POLICY.md)",
    "Read(/{{ .chezmoi.homeDir }}/.local/share/agent-policy/skills/document-governance/**)",
    "Read(/{{ .chezmoi.homeDir }}/.local/share/agent-policy/skills/project-state/**)",
    "Read(/{{ .chezmoi.homeDir }}/.local/share/agent-policy/skills/speak/**)"
  ]' '
  def ours($hook):
    ($hook.command // "") as $command
    | (($markers | any(. as $marker | $command | contains($marker)))
       or ($legacyPrefixes | any(. as $prefix | $command | startswith($prefix)))
       or ($command | contains("graft-hooks.cjs")));
  def drop_managed:
    with_entries(
      .value |= (
        map(
          .hooks = ((.hooks // []) | map(select(ours(.) | not)))
          | select((.hooks | length) > 0)
        )
        | select(length > 0)
      )
    );
  def managed_policy_read:
    (type == "string") and startswith("Read(" + $policyRoot + "/");
  def append_unique($items):
    reduce $items[] as $item (.;
      if index($item) then . else . + [$item] end);
  .hooks = ((.hooks // {}) | drop_managed)
  | reduce ($declared.hooks | to_entries[]) as $event
      (.; .hooks[$event.key] = ($event.value + (.hooks[$event.key] // [])))
  | .permissions = ((.permissions // {})
      | .allow = (((.allow // []) | map(select(managed_policy_read | not)))
          | append_unique($agentPolicyAllow)))
')"

AGENT_POLICY="${AGENT_POLICY_HOME:-{{ .chezmoi.homeDir }}/.local/share/agent-policy}/agent-policy"
if [ -x "$AGENT_POLICY" ]; then
  printf '%s' "$merged" | "$AGENT_POLICY" --harness claude filter
else
  printf '%s\n' "$merged"
fi
